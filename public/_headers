# Cloudflare Pages response headers.
#
# Astro emits content-hashed bundles under /_astro/, so they are safe to cache forever.
# The zone's Browser Cache TTL is "Respect Existing Headers" (2026-11-17), so without
# this rule they would fall back to Pages' default `max-age=0, must-revalidate`.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
