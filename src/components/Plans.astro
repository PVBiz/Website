---
// Plan cards shared by the home pricing summary and /pricing/. Prices are fixed per
// currency (data attributes, never converted); ZAR is the default in the HTML.
import Check from './Check.astro';
import { REGISTER } from '../data/brands';

interface Props {
  /** Show the currency switcher and heading row. */
  heading: string;
  intro: string;
}
const { heading, intro } = Astro.props;
---

<div class="pricing-top">
  <div class="section-head flush">
    <h2>{heading}</h2>
    <p>{intro}</p>
  </div>
  <div class="segmented" role="group" aria-label="Currency">
    <button type="button" data-currency="ZAR" aria-pressed="true">ZAR</button>
    <button type="button" data-currency="USD" aria-pressed="false">USD</button>
    <button type="button" data-currency="EUR" aria-pressed="false">EUR</button>
    <button type="button" data-currency="GBP" aria-pressed="false">GBP</button>
  </div>
</div>

<div class="plans">
  <article class="plan">
    <p class="plan-name">Monthly</p>
    <p class="price" data-zar="55" data-usd="5.30" data-eur="4.90" data-gbp="4.20">
      R55<span class="per">a month</span>
    </p>
    <p class="price-note">Cancel any time.</p>
    <ul>
      <li><Check />2 solar plants, any brands</li>
      <li><Check />Alerts, rules, forecasts, reports, automation</li>
      <li><Check />Email support</li>
    </ul>
    <a class="btn btn-secondary" href={REGISTER}>Start monthly plan</a>
  </article>

  <article class="plan plan-featured">
    <p class="plan-name">Yearly <span class="tag">Best value</span></p>
    <p class="price" data-zar="549" data-usd="42.00" data-eur="39.00" data-gbp="34.00">
      R549<span class="per">a year</span>
    </p>
    <p class="price-note" data-zar-only>Two months free against monthly billing.</p>
    <ul>
      <li><Check />Everything in Monthly</li>
      <li><Check />One payment, no renewals to think about</li>
      <li><Check />Email support</li>
    </ul>
    <a class="btn btn-primary" href={REGISTER}>Start yearly plan</a>
  </article>

  <article class="plan">
    <p class="plan-name">Installers and fleets</p>
    <p class="price">Per fleet</p>
    <p class="price-note">Priced on sites under management.</p>
    <ul>
      <li><Check />Unlimited plants across 14+ brands</li>
      <li><Check />Team roles, branded client reports</li>
      <li><Check />Work orders, tariffs, PPA and REC tracking</li>
    </ul>
    <a class="btn btn-secondary" href="/contact/">Book a demo</a>
  </article>
</div>

<div class="addon" data-zar-only>
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
    ><path
      d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.2-.6.8-.8 1-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2c0 1.3.9 2.5 1.1 2.7.1.2 1.9 2.9 4.5 4 1.7.7 2.3.8 3.1.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.5-.3z"
    ></path></svg
  >
  <p>
    <strong>WhatsApp notifications</strong> are an optional add-on: message bundles you top up on any
    plan, using the same alert rules as your other channels. Available to South African customers.
  </p>
</div>
