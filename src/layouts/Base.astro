---
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/brands';

interface Preload {
  href: string;
  as: string;
  type?: string;
}

interface Props {
  title: string;
  description: string;
  /** Canonical path with trailing slash, e.g. "/installers/". */
  path: string;
  ogTitle?: string;
  ogImage?: string;
  jsonLd?: object[];
  preload?: Preload[];
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  ogTitle = title,
  ogImage = `${SITE}/img/og-card.jpg`,
  jsonLd = [],
  preload = [],
  noindex = false,
} = Astro.props;

const canonical = `${SITE}${path}`;

// Bing flags descriptions outside 25-160 characters; Google truncates past ~155.
if (description.length < 25 || description.length > 158) {
  throw new Error(`${path}: meta description is ${description.length} characters; keep it 25-158.`);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="facebook-domain-verification" content="1ddplc5p501esusgnhltt8udqkwcx3" />

    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="PVBiz: monitoring, alerts, forecasts and reports for 14+ inverter brands and platforms"
    />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PVBiz" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="preload"
      href="/fonts/inter-latin-opsz-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {preload.map((p) => (
      <link rel="preload" href={p.href} as={p.as} type={p.type} fetchpriority="high" />
    ))}
    <link rel="icon" href="/img/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/img/pvbiz_logo.png" type="image/png" />
    <link rel="apple-touch-icon" href="/img/pvbiz_logo.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {jsonLd.map((node) => (
      <script type="application/ld+json" set:html={JSON.stringify(node)} />
    ))}
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline src="/js/site.js" defer></script>
  </body>
</html>
