---
import Base from '../layouts/Base.astro';
import { REGISTER } from '../data/brands';
---

<Base
  title="Page not found - PVBiz"
  description="That page does not exist on www.pvbiz.co.za. Find PVBiz solar monitoring for homeowners, installers and commercial sites."
  path="/404/"
  noindex
>
  <section class="section notfound">
    <div class="container">
      <div class="section-head">
        <h1>That page is not here.</h1>
        <p>
          The address may have changed when the site moved. The pages people usually want are below.
        </p>
      </div>
      <ul class="related">
        <li>
          <a href="/">Home</a>
        </li>
        <li>
          <a href="/installers/">Installers and O&amp;M teams</a>
        </li>
        <li>
          <a href="/homeowners/">Homeowners</a>
        </li>
        <li>
          <a href="/commercial/">Commercial and asset owners</a>
        </li>
        <li>
          <a href="/pricing/">Pricing</a>
        </li>
        <li>
          <a href="/integrations/">Integrations</a>
        </li>
        <li>
          <a href="/contact/">Contact</a>
        </li>
        <li>
          <a href={REGISTER}>Start free trial</a>
        </li>
      </ul>
    </div>
  </section>
</Base>
