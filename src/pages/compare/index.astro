---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE, breadcrumbs } from '../../data/brands';

const entries = (await getCollection('compare')).sort((a, b) =>
  a.data.competitor.localeCompare(b.data.competitor),
);
---

<Base
  title="Compare PVBiz with other solar monitoring tools"
  description="How PVBiz compares with brand monitoring apps, installer platforms and local monitors. Dated and sourced, including where the other tool is the better fit."
  path="/compare/"
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: 'PVBiz comparisons',
      itemListElement: entries.map((e, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: e.data.title,
        url: `${SITE}/compare/${e.id}/`,
      })),
    },
    breadcrumbs([{ name: 'Compare', path: '/compare/' }]),
  ]}
>
  <section class="page-head">
    <div class="container">
      <ol class="crumbs">
        <li><a href="/">Home</a></li>
        <li>Compare</li>
      </ol>
      <h1>How PVBiz compares</h1>
      <p class="answer">
        Side-by-side comparisons with the monitoring tools people weigh PVBiz against. Every claim
        about another product links to a public source and carries the date we checked it, and each
        page says where the other tool is the better fit.
      </p>
    </div>
  </section>

  <section class="section-tight alt hairline-top">
    <div class="container">
      <ul class="compare-list">
        {
          entries.map((e) => (
            <li>
              <a href={`/compare/${e.id}/`}>
                <h2>{e.data.title}</h2>
                <p>{e.data.description}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
