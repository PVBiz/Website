---
import Base from '../layouts/Base.astro';
import { APP, EMAIL, ORGANIZATION, PHONE, PHONE_TEL, REGISTER, SITE, breadcrumbs } from '../data/brands';

const demoMail = `mailto:${EMAIL}?subject=${encodeURIComponent('PVBiz demo request')}`;
const supportMail = `mailto:${EMAIL}?subject=${encodeURIComponent('PVBiz question')}`;

const contactPage = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact PVBiz',
  url: `${SITE}/contact/`,
  mainEntity: ORGANIZATION,
};
---

<Base
  title="Contact PVBiz - book a demo or ask a question"
  description="Contact PVBiz in Johannesburg, South Africa: info@pvbiz.co.za or +27 61 546 7165. Book an Installer Platform demo on your own fleet, or ask about a brand, pricing or your account."
  path="/contact/"
  jsonLd={[contactPage, breadcrumbs([{ name: 'Contact', path: '/contact/' }])]}
>
  <section class="page-head">
    <div class="container">
      <ol class="crumbs">
        <li><a href="/">Home</a></li>
        <li>Contact</li>
      </ol>
      <h1>Talk to us.</h1>
      <p class="answer">
        Email <a href={`mailto:${EMAIL}`}>{EMAIL}</a> or call <a href={`tel:${PHONE_TEL}`}>{PHONE}</a>. We are
        in Johannesburg, South Africa, and answer in South African office hours.
      </p>
    </div>
  </section>

  <section class="section-tight alt hairline-top" id="demo">
    <div class="container">
      <div class="contact-grid">
        <article class="panel panel-night">
          <h2>Book a demo</h2>
          <p>
            For installers, O&amp;M teams and asset owners. Tell us roughly how many sites you have
            and which portals they report to. We connect a few of them and walk you through the
            fleet view, alerts, reports and tariff-based savings on your own data.
          </p>
          <dl>
            <div><dt>Email</dt><dd><a href={demoMail}>{EMAIL}</a></dd></div>
            <div><dt>Phone</dt><dd><a href={`tel:${PHONE_TEL}`}>{PHONE}</a></dd></div>
          </dl>
          <div class="panel-cta">
            <a class="btn btn-primary" href={demoMail}>Email a demo request</a>
            <a href="/installers/">About the Installer Platform</a>
          </div>
        </article>

        <article class="panel">
          <h2>Questions and support</h2>
          <p>
            Ask about a brand, pricing, or your account. If you already use PVBiz, include the email
            address on the account so we can find it.
          </p>
          <dl>
            <div><dt>Email</dt><dd><a href={supportMail}>{EMAIL}</a></dd></div>
            <div><dt>Location</dt><dd>Johannesburg, Gauteng, South Africa</dd></div>
          </dl>
          <div class="panel-cta">
            <a class="btn btn-secondary" href={supportMail}>Email a question</a>
            <a class="text-link" href={APP}>Sign in to the app</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="self-serve">
    <div class="container">
      <div class="section-head">
        <h2>Prefer to try it yourself?</h2>
        <p>A homeowner or small-business plant needs no demo: the free trial is seven days, with no card needed.</p>
      </div>
      <div class="hero-cta">
        <a class="btn btn-primary btn-lg" href={REGISTER}>Start free trial</a>
        <a class="btn btn-secondary btn-lg" href="/integrations/">How connecting works</a>
      </div>
    </div>
  </section>
</Base>
